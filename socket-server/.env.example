SOCKET_PORT=3001
SOCKET_INTERNAL_SECRET=change-me-to-a-long-random-string
# عنوان التطبيق المركزي (نفس APP_URL في Laravel) — للتحقق الاحتياطي
LARAVEL_VERIFY_URL=https://my-bee.info
# Laravel على نفس السيرفر (لـ internal snapshot)
LARAVEL_INTERNAL_URL=http://127.0.0.1
TENANT_URL_TEMPLATE=http://{tenant}.localhost
# Laravel .env must match SOCKET_INTERNAL_SECRET and SOCKET_BROADCAST_URL=http://127.0.0.1:3001/broadcast
