APP_NAME="My Bee"
# اسم المنتج في الواجهة وPDF والبريد (عربي وإنجليزي)
# APP_BRAND_SHORT_AR="My Bee"
# APP_BRAND_SHORT_EN="My Bee"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_DOMAIN=localhost

# Socket.IO (Waiter app) — see socket-server/.env.example
SOCKET_BROADCAST_URL=http://127.0.0.1:3001/broadcast
SOCKET_INTERNAL_SECRET=
# Company API tokens (company-login) — leave empty for no expiration
COMPANY_API_TOKEN_EXPIRATION_MINUTES=
COMPANY_API_REVOKE_PREVIOUS=false
# Must match clients (central) TENANT_SWITCH_SECRET
TENANT_SWITCH_SECRET=
App_test=Hi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Central (membership) DB connection used to list "My companies"
# Must point to the central app database (clients).
CENTRAL_DB_CONNECTION=central
CENTRAL_DB_DRIVER=mysql
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=3306
# CENTRAL_DB_DATABASE=clients
# CENTRAL_DB_USERNAME=root
# CENTRAL_DB_PASSWORD=

# Public URL of the central SaaS app (referral invite links)
CENTRAL_APP_URL=https://mybeesystem.net

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ZATCA Phase 2 (Fatoora) — see Modules/Zatca/README.md
ZATCA_SHOW_IN_MENU=true
ZATCA_ENVIRONMENT=local
ZATCA_APP_KEY=
ZATCA_LOCAL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_SIMULATION=https://gw-fatoora.zatca.gov.sa/e-invoicing/simulation
ZATCA_PRODUCTION=https://gw-fatoora.zatca.gov.sa/e-invoicing/core

# Accounting maintenance tools (tree of accounts)
# Show repair GL codes button: true|false
ACCOUNTING_SHOW_REPAIR_GL_CODES=false
# Show full accounting reset button: true|false (execution still requires allow_full_reset or local/staging)
ACCOUNTING_SHOW_FULL_RESET=false
# Allow executing full accounting reset via POST
ACCOUNTING_ALLOW_FULL_RESET=false
