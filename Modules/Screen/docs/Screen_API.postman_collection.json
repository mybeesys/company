                            "body": "{\n  \"message\": \"تمت العملية بنجاح\"\n}"
                        }
                    ]
                },
                {
                    "name": "Update promo (name)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"اسم جديد للمادة الإعلانية\"\n}"
                        },
                        "url": "{{baseUrl}}/promos/{{promoId}}"
                    },
                    "response": []
                },
                {
                    "name": "Delete promo",
                    "request": {
