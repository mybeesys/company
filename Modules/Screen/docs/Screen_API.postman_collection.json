                        ],
                        "url": "{{baseUrl}}/promos/{{promoId}}"
                    },
                    "response": []
                },
                {
                    "name": "Create promo (multipart)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "promo",
                                    "description": "صورة أو فيديو: jpeg,jpg,png,mp4,mov,avi,webm,mkv — حتى ~120MB",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/promos",
                        "description": "اختر ملفاً حقيقياً من Postman في حقل `promo`."
                    },
                    "response": [
                        {
                            "name": "مثال 201",
                            "originalRequest": {
                                "method": "POST",
                                "url": "{{baseUrl}}/promos"
                            },
                            "status": "Created",
                            "code": 201,
